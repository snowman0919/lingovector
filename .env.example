# Shared
# Use development locally. Production mode fails fast unless required beta env vars are present.
ENVIRONMENT=development
# Keep true only for local development. Production rejects DEV_AUTH=true.
DEV_AUTH=true
# School beta is restricted to verified @dimigo.hs.kr Google accounts.
ALLOWED_EMAIL_DOMAIN=dimigo.hs.kr

# Backend
BIND_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lingovector
# Production: set a generated value with at least 32 characters. Never commit the real value.
JWT_SECRET=replace-with-a-long-random-secret
# Production: use explicit https origins, for example https://lingovector.example.edu.
CORS_ORIGINS=http://localhost:3000
STORAGE_DIR=./apps/api/storage

# Google OAuth
# Backend OAuth client ID. Required in production.
GOOGLE_CLIENT_ID=

# Server-side Supertone/Supertonic fallback integration
# Browser ONNX TTS is preferred for beta when model assets are provided.
# Leave empty to use mock/server fallback providers.
SUPERTONE_API_KEY=
SUPERTONE_BASE_URL=https://api.supertone.ai
SUPERTONE_LOCAL_TTS_URL=
SUPERTONE_LOCAL_VOICE_URL=

# Optional real provider integrations. Empty values use mock providers.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
PRONUNCIATION_PROVIDER_URL=
ARXIV_REAL_ENABLED=false
# Production diagnostics remain off unless this is explicitly true.
DIAGNOSTICS_ENABLED=false

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8080
# Browser Google Identity Services client ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Production diagnostics panel remains hidden unless this is explicitly true.
NEXT_PUBLIC_DIAGNOSTICS_ENABLED=false
# browser_onnx runs TTS on device when model/schema files are available; server uses /tts; mock is frontend-only test timing/audio.
NEXT_PUBLIC_TTS_MODE=server
NEXT_PUBLIC_SUPERTONIC_ONNX_MODEL_URL=/models/supertonic/model.onnx
NEXT_PUBLIC_SUPERTONIC_ONNX_CONFIG_URL=
