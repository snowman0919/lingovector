{
  "name": "lingovector",
  "private": true,
  "version": "0.3.0",
  "scripts": {
    "dev": "npm run dev:web",
    "dev:db": "bash scripts/dev-db.sh",
    "dev:db:logs": "docker compose logs -f postgres",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:api": "cargo run -p lingovector-api",
    "dev:health": "curl -fsS http://127.0.0.1:8080/health",
    "build": "npm --workspace apps/web run build",
    "lint": "npm --workspace apps/web run lint",
    "format:api": "cargo fmt --all",
    "clippy:api": "cargo clippy --workspace --all-targets -- -D warnings",
    "migrate:check": "bash scripts/migration-check.sh",
    "ops:storage": "bash scripts/storage-usage.sh",
    "ops:cleanup-local-output": "bash scripts/cleanup-local-output.sh",
    "test:api": "cargo test --workspace",
    "test:api-smoke": "node scripts/api-smoke.mjs",
    "test:authenticated-smoke": "node scripts/authenticated-smoke.mjs",
    "test:provider-preflight": "node scripts/provider-preflight.mjs",
    "test:staging-smoke": "node scripts/staging-smoke.mjs",
    "test:tts-smoke": "node scripts/tts-smoke.mjs",
    "test:arxiv-smoke": "node scripts/arxiv-smoke.mjs",
    "test:learning-quality": "node scripts/learning-quality-fixtures.mjs",
    "test:web": "node scripts/frontend-smoke.mjs"
  },
  "workspaces": [
    "apps/web"
  ]
}
