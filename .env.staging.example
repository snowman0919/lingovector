# Lingovector staging rehearsal template.
# Copy to .env.staging and fill real staging-only values outside git.
# Do not casually reuse production secrets. Do not use real student data in staging unless explicitly approved.

# Staging is production-like: Google OAuth, HTTPS CORS, no dev auth by default.
APP_ENV=staging
DEV_AUTH=false
BIND_ADDR=0.0.0.0:8080

# Required backend values for staging.
# Use a staging database, not the production database.
DATABASE_URL=
JWT_SECRET=
GOOGLE_CLIENT_ID=
ALLOWED_EMAIL_DOMAIN=dimigo.hs.kr
CORS_ORIGINS=https://lingovector.kotori9.run
STORAGE_DIR=/app/storage

# Keep diagnostics off by default. Temporarily enable only during an operator check,
# then set false and restart the API.
DIAGNOSTICS_ENABLED=false

# Frontend public values baked into the staging web build.
# Use /api for same-origin Cloudflare Tunnel routing.
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_DIAGNOSTICS_ENABLED=false
# Preferred staging TTS path once model files are mounted/deployed.
NEXT_PUBLIC_TTS_MODE=browser_onnx
NEXT_PUBLIC_SUPERTONIC_ONNX_MODEL_URL=/models/supertonic/model.onnx
NEXT_PUBLIC_SUPERTONIC_ONNX_CONFIG_URL=

# Optional LLM provider. Leave empty for mock mode.
# Confirm cost/privacy risk before enabling real calls in staging.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini

# Optional server-side Supertone/Supertonic fallback providers. Leave empty for mock mode.
SUPERTONE_API_KEY=
SUPERTONE_BASE_URL=https://api.supertone.ai
SUPERTONE_LOCAL_TTS_URL=
SUPERTONE_LOCAL_VOICE_URL=

# Optional pronunciation provider. Leave empty for mock mode.
PRONUNCIATION_PROVIDER_URL=

# Optional arXiv real fetch. false keeps mock fallback.
ARXIV_REAL_ENABLED=false

# Rehearsal compose only. Use a strong staging-only value in .env.staging.
POSTGRES_USER=lingovector_staging
POSTGRES_PASSWORD=
POSTGRES_DB=lingovector_staging
