# Lingovector production/staging rehearsal template.
# Copy to .env.production for a rehearsal. Never commit the real .env.production file.
# 학생용 UI는 한국어입니다. 영어 지문/예시/정의/학생 영작은 영어로 유지합니다.

# Runtime mode. Required.
ENVIRONMENT=production
DEV_AUTH=false

# API binding inside the container/server. Safe default for reverse proxy or tunnel.
BIND_ADDR=0.0.0.0:8080

# Required backend values. Fill with real runtime secrets outside git.
# DATABASE_URL은 rehearsal compose의 postgres 또는 managed PostgreSQL을 가리킵니다.
DATABASE_URL=
JWT_SECRET=
GOOGLE_CLIENT_ID=
ALLOWED_EMAIL_DOMAIN=dimigo.hs.kr
CORS_ORIGINS=https://lingovector.kotori9.run
STORAGE_DIR=/app/storage

# Diagnostics are off by default in production. Enable only for a short admin check.
DIAGNOSTICS_ENABLED=false

# Frontend public values. These are baked into the web build.
# Single-domain Cloudflare Tunnel default:
# Web origin: https://lingovector.kotori9.run
# API path:   https://lingovector.kotori9.run/api
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_DIAGNOSTICS_ENABLED=false
# Preferred beta TTS path: browser_onnx with model files deployed outside git.
# Use server for the backend /tts fallback, or mock only for isolated verification.
NEXT_PUBLIC_TTS_MODE=browser_onnx
NEXT_PUBLIC_SUPERTONIC_ONNX_MODEL_URL=/models/supertonic/model.onnx
NEXT_PUBLIC_SUPERTONIC_ONNX_CONFIG_URL=

# Optional LLM provider. Leave empty for mock mode.
# 실제 provider 사용 전 비용/개인정보 위험을 확인하세요.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini

# Optional server-side Supertone/Supertonic fallback providers. Leave empty for mock mode.
# Browser ONNX TTS is the preferred beta direction. SUPERTONE_LOCAL_TTS_URL/SUPERTONE_LOCAL_VOICE_URL can point to a safe local server.
SUPERTONE_API_KEY=
SUPERTONE_BASE_URL=https://api.supertone.ai
SUPERTONE_LOCAL_TTS_URL=
SUPERTONE_LOCAL_VOICE_URL=

# Optional pronunciation provider. Leave empty for mock mode.
PRONUNCIATION_PROVIDER_URL=

# Optional arXiv real fetch.
ARXIV_REAL_ENABLED=false

# Rehearsal compose only. Use a strong value in local .env.production; do not commit it.
POSTGRES_USER=lingovector
POSTGRES_PASSWORD=
POSTGRES_DB=lingovector
